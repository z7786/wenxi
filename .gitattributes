* text=auto
*.dart text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.go text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.swift text eol=lf
*.podspec text eol=lf
*.xcconfig text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
# Preserve the upstream document runtime bytes checked by its manifest.
assets/documents/vendor/** -text linguist-vendored
assets/documents/*.html text eol=lf
assets/documents/*.css text eol=lf
assets/documents/*.js text eol=lf
assets/documents/*.mjs text eol=lf
# SSE event fixtures retain the blank line terminating their last event.
*.sse whitespace=-blank-at-eof
native/gopeed/vendor/** linguist-vendored
vendor_plugins/** linguist-vendored
windows/installer/languages/*.isl text eol=lf
